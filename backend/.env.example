# ---- Core ----
APP_NAME="Zak Store"
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string

# ---- Admin login ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Database ----
# Local dev (default): SQLite file
DATABASE_URL=sqlite:///./store.db
# Production (Netlify DB / Neon Postgres) e.g.:
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require

# ---- CORS: comma separated, or * for all ----
CORS_ORIGINS=*

# ---- Email notifications (optional) ----
# Any SMTP provider works. Free options that are plenty for a small store:
#   Gmail   — smtp.gmail.com:587, user = your address, password = a Google
#             "App password" (Google Account > Security > 2-Step > App passwords).
#             NOT your normal Gmail password. ~500 emails/day.
#   Brevo   — smtp-relay.brevo.com:587, 300 emails/day free.
#   Resend  — smtp.resend.com:587, user "resend", password = API key. 3,000/month free.
# The recipient address and on/off switch live in the admin dashboard, not here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ---- Web Push (generate with: ./.venv/bin/python -m app.vapid_keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:developer@hayatinapp.com
